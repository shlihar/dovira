APP_NAME=DOVIRA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dovira
DB_USERNAME=dovira
DB_PASSWORD=change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=2400

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

AI_ENRICHMENT_PROVIDER=openai
AI_ENRICHMENT_QUEUE_CONNECTION=redis
AI_ENRICHMENT_QUEUE=ai-enrichment
AI_ENRICHMENT_PRIORITY_QUEUE=ai-enrichment-priority
AI_REVIEW_ANALYSIS_QUEUE=ai-review-analysis
AI_ENRICHMENT_AUTO_START_WORKER=false
AI_ENRICHMENT_QUEUE_WORKER_PROCESSES=2
AI_ENRICHMENT_QUEUE_WORKER_SLEEP=1
AI_ENRICHMENT_QUEUE_WORKER_TRIES=3
AI_ENRICHMENT_QUEUE_WORKER_BACKOFF=5
AI_ENRICHMENT_QUEUE_WORKER_TIMEOUT=1800
AI_ENRICHMENT_QUEUE_WORKER_MAX_TIME=3600
AI_ENRICHMENT_RELEASE_STALE_RESERVED_AFTER_SECONDS=1800

OPENAI_API_KEY=
AI_ENRICHMENT_OPENAI_MODEL=gpt-4.1-mini
AI_ENRICHMENT_OPENAI_TIMEOUT=60
AI_ENRICHMENT_OPENAI_LOGO_SEARCH_TIMEOUT=12
AI_ENRICHMENT_OPENAI_RETRIES=1
AI_ENRICHMENT_OPENAI_WEB_SEARCH=true

GOOGLE_MAPS_API_KEY=
AI_ENRICHMENT_GOOGLE_MAPS_REVIEWS=true
AI_ENRICHMENT_GOOGLE_MAPS_SEARCH_ENDPOINT=https://places.googleapis.com/v1/places:searchText
AI_ENRICHMENT_GOOGLE_MAPS_DETAILS_ENDPOINT=https://places.googleapis.com/v1
AI_ENRICHMENT_GOOGLE_MAPS_LANGUAGE=uk
AI_ENRICHMENT_GOOGLE_MAPS_TIMEOUT=20
AI_ENRICHMENT_TOP20_ENABLED=true
AI_ENRICHMENT_TOP20_TIMEOUT=12
AI_ENRICHMENT_TOP20_MAX_REVIEWS=50
