APP_NAME=Dovira
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Єдина БД проєкту — MySQL (hb423250.mysql.tools). SQLite не використовується.
DB_CONNECTION=mysql
DB_HOST=hb423250.mysql.tools
DB_PORT=3306
DB_DATABASE=hb423250_dovira
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=dovira_session
# Production (HTTPS): cookie лише по HTTPS і недоступна для JS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Черга живе в таблиці jobs основної MySQL (DB_QUEUE_CONNECTION порожній =
# основне зʼєднання).
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=1200
TOP20_BULK_IMPORT_PROFILE_FETCH_CONCURRENCY=4
TOP20_BULK_IMPORT_REVIEW_FETCH_CONCURRENCY=8
TOP20_BULK_IMPORT_MAX_REVIEWS_PER_PROFILE=100
TOP20_BULK_IMPORT_DOWNLOAD_REVIEW_AVATARS=true
TOP20_BULK_IMPORT_MAX_LISTING_PAGES=250

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=2400

# Local: MAIL_MAILER=log (листи пишуться в storage/logs/laravel.log).
# Production: MAIL_MAILER=smtp + реальні SMTP-креденшли (Resend/Postmark/SES
# або SMTP хостингу домену). FROM-адреса має бути на вашому домені,
# інакше листи потраплятимуть у спам (перевірте SPF/DKIM у DNS).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@dovira.com.ua"
MAIL_FROM_NAME="${APP_NAME}"

DOVIRA_CONTACT_EMAIL=info@mydovira.com
DOVIRA_SUPPORT_TELEGRAM=dovira_support
DOVIRA_CONTACT_PHONE=+380937269578

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cloudflare Turnstile (антиспам гостьових відгуків). Без ключів перевірка
# вимкнена. Ключі: dash.cloudflare.com -> Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_MAX_AGE=86400
# Куди слати адмін-сповіщення (новий відгук, профіль, заявка, PRO). Один або
# кілька chat_id через кому. Як дізнатись: напишіть боту, потім
# `php artisan dovira:telegram-admin-test --chat-ids`. Порожньо = вимкнено.
TELEGRAM_ADMIN_CHAT_ID=

# Оплата PRO через monopay / monobank acquiring. Див. config/payments.php.
MONOPAY_API_TOKEN=
MONOPAY_BASE_URL=https://api.monobank.ua/api/merchant
# Опційно: base64 public key з /api/merchant/pubkey. Якщо порожньо, app
# спробує отримати ключ через API і закешувати його.
MONOPAY_WEBHOOK_PUBLIC_KEY=
PAY_PRO_NAME="DOVIRA PRO — підписка на 6 місяців"
PAY_PRO_DESCRIPTION="PRO-можливості профілю на DOVIRA: розширена сторінка, відповіді на відгуки, аналітика та заявки клієнтів."
PAY_PRO_AMOUNT=1999
PAY_PRO_CURRENCY=UAH
PAY_PRO_CURRENCY_CODE=980
PAY_PRO_VALIDITY_SECONDS=3600

AI_ENRICHMENT_PROVIDER=local
AI_ENRICHMENT_QUEUE_CONNECTION=database
AI_ENRICHMENT_QUEUE=ai-enrichment
AI_ENRICHMENT_AUTO_START_WORKER=true
AI_ENRICHMENT_QUEUE_WORKER_PROCESSES=1
AI_ENRICHMENT_QUEUE_WORKER_SLEEP=1
AI_ENRICHMENT_QUEUE_WORKER_TRIES=3
AI_ENRICHMENT_QUEUE_WORKER_BACKOFF=5
AI_ENRICHMENT_QUEUE_WORKER_TIMEOUT=1800
AI_ENRICHMENT_QUEUE_WORKER_MAX_TIME=3600
AI_ENRICHMENT_RELEASE_STALE_RESERVED_AFTER_SECONDS=1800

# Production recommendation:
# QUEUE_CONNECTION=redis
# AI_ENRICHMENT_QUEUE_CONNECTION=redis
# AI_ENRICHMENT_AUTO_START_WORKER=true
# AI_ENRICHMENT_QUEUE_WORKER_PROCESSES=3

OPENAI_API_KEY=
AI_ENRICHMENT_OPENAI_MODEL=gpt-4.1-mini
AI_REVIEW_ANALYSIS_OPENAI_MODEL=gpt-4.1
AI_REVIEW_ANALYSIS_TIMEOUT=20
AI_ENRICHMENT_OPENAI_TIMEOUT=60
AI_ENRICHMENT_OPENAI_LOGO_SEARCH_TIMEOUT=12
AI_ENRICHMENT_OPENAI_RETRIES=1
AI_ENRICHMENT_OPENAI_WEB_SEARCH=false
AI_ENRICHMENT_GOOGLE_MAPS_REVIEWS=false
GOOGLE_MAPS_API_KEY=
AI_ENRICHMENT_GOOGLE_MAPS_SEARCH_ENDPOINT=https://places.googleapis.com/v1/places:searchText
AI_ENRICHMENT_GOOGLE_MAPS_DETAILS_ENDPOINT=https://places.googleapis.com/v1
AI_ENRICHMENT_GOOGLE_MAPS_LANGUAGE=uk
AI_ENRICHMENT_GOOGLE_MAPS_TIMEOUT=20
AI_ENRICHMENT_TOP20_ENABLED=true
AI_ENRICHMENT_TOP20_TIMEOUT=12
AI_ENRICHMENT_TOP20_MAX_REVIEWS=50

AI_ENRICHMENT_PRIORITY_QUEUE=ai-enrichment-priority
AI_REVIEW_ANALYSIS_QUEUE=ai-review-analysis
